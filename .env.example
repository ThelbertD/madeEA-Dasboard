# Copy to .env and fill in. .env is gitignored.

# GHL Settings > Private Integrations. Starts pit-
GHL_PRIVATE_TOKEN=

# The sub-account id, visible in the GHL dashboard URL
GHL_LOCATION_ID=

# Passphrase the dashboard sends. Without it the API refuses to serve,
# rather than defaulting to public.
DASHBOARD_KEY=

# Optional: comma-separated calendar ids to count appointments on.
# Leave blank to scan every calendar on the location.
GHL_CALENDAR_IDS=
